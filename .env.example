# Copy to .env.local and fill in. NEVER commit .env.local.
#
# Local dev: values come from `supabase start` output.
# The anon key is safe to expose to the browser (RLS protects data).
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# SERVER ONLY. Bypasses RLS — must never reach the client bundle or git.
# Used only by the audited server-side data layer for privileged operations.
SUPABASE_SERVICE_ROLE_KEY=

# App
NEXT_PUBLIC_SITE_URL=http://localhost:3000
